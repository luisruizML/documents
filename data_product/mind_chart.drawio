                    <mxGeometry x="580" y="-196.37" width="20" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="Internally, we face scaling and quality constraints rooted in our legacy ways of working" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="380" y="-54.370000000000005" width="180" height="45" as="geometry"/>
