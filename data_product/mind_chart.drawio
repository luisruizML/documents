                <mxCell id="13" value="- Repeated information requests&#10;- Long queues&#10;- Fragmented services&#10;- Complex forms for even the simplest tasks" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;horizontal=1;" vertex="1" parent="1">
