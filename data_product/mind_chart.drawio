                </mxCell>
                <mxCell id="36" value="Debt &amp;amp; Delinquency Management" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1630" y="-701.5" width="180" height="31.5" as="geometry"/>
                </mxCell>
                <mxCell id="37" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1830" y="-1064.1925" width="20" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="38" value="&lt;div&gt;- Limited capacity&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Manual processes (OECD, SME Tax Gap Analysis).&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Informal sector participation exceeds 30–50% of the labor force, making voluntary compliance structurally difficult (ILO/IMF).&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;horizontal=1;" vertex="1" parent="1">
                    <mxGeometry x="1850" y="-1056.0675" width="340" height="78.75" as="geometry"/>
                </mxCell>
                <mxCell id="39" value="Fragmented Data Ecosystem &amp;amp; Siloed Services" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1630" y="-259.9975000000002" width="180" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="40" value="Low Audit Effectiveness" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1630" y="-591.1875000000001" width="180" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="41" value="Sudden Legislative Changes &amp;amp; Low Agility" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1630" y="-480.2475000000002" width="180" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="42" value="Legacy IT &amp;amp; Technical Debt" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1630" y="-377.6875000000001" width="180" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="45" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1830" y="-954.3125000000001" width="20" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="46" value="&lt;div&gt;- Low-income and small economies spend 100–250 hrs/y on tax compliance vs ~40 in advanced economies&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Facing disproportionate compliance burdens&lt;/div&gt;&lt;div&gt;- Burden is amplified in SIDS due to small administrations and manual processes.&lt;/div&gt;&lt;div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;horizontal=1;" vertex="1" parent="1">
                    <mxGeometry x="1850" y="-946.1875000000001" width="340" height="78.75" as="geometry"/>
                </mxCell>
                <mxCell id="47" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1830" y="-828.3125000000001" width="20" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="48" value="&lt;div&gt;- Fragmented ID systems&lt;/div&gt;&lt;div&gt;- Duplicated TINs&lt;/div&gt;&lt;div&gt;- Mismatched population records (birth/death/migration)&lt;/div&gt;&lt;div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;horizontal=1;" vertex="1" parent="1">
                    <mxGeometry x="1850" y="-835.1875000000001" width="340" height="78.75" as="geometry"/>
                </mxCell>
                <mxCell id="49" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1830" y="-707.3075000000001" width="20" height="43.12" as="geometry"/>
                </mxCell>
                <mxCell id="50" value="- Weaker recovery due to small teams and manual casework (TADAT reports).&lt;div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;horizontal=1;" vertex="1" parent="1">
                    <mxGeometry x="1850" y="-714.1875000000001" width="340" height="56.88" as="geometry"/>
                </mxCell>
                <mxCell id="51" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1830" y="-610.5725000000001" width="20" height="68.77" as="geometry"/>
                </mxCell>
                <mxCell id="52" value="&lt;div&gt;- Traditional audits are slow, costly and downstream, and rarely change long-term compliance behaviour&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Lack of integrated data across agencies weakens risk profiling and reduces audit yield.&lt;/div&gt;&lt;div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;horizontal=1;" vertex="1" parent="1">
                    <mxGeometry x="1850" y="-611.1875000000001" width="340" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="53" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1830" y="-497.75250000000005" width="20" height="65.01" as="geometry"/>
                </mxCell>
                <mxCell id="54" value="&lt;div&gt;- Frequently adjust tax rates and exemptions during budget cycles or crises.&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Legal updates slow and error-prone&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;horizontal=1;" vertex="1" parent="1">
                    <mxGeometry x="1850" y="-496.1875000000001" width="340" height="61.88" as="geometry"/>
                </mxCell>
                <mxCell id="55" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1830" y="-402.6875000000001" width="20" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="56" value="&lt;div&gt;- Many SIDS operate systems that are 10–20+ years old&lt;/div&gt;&lt;div&gt;- Highly customized&lt;/div&gt;&lt;div&gt;- Expensive to maintain&lt;/div&gt;&lt;div&gt;- Legacy maintenance consumes 30–50% of IT budgets.&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Lack of APIs, event-driven architecture, and data standards block real-time processes and integration&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;horizontal=1;" vertex="1" parent="1">
                    <mxGeometry x="1850" y="-403.1875000000001" width="340" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="57" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1830" y="-292.4975000000002" width="20" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="58" value="&lt;div&gt;- Tax administrations rely on manual, siloed, downstream processes with poor data exchange.&amp;nbsp;&lt;/div&gt;&lt;div&gt;- SMEs often must extract data from their business systems and re-enter it into tax systems&lt;/div&gt;&lt;div&gt;- SIDS struggle to integrate with registrars, customs, local govs, social funds, banks&lt;/div&gt;&lt;div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;horizontal=1;" vertex="1" parent="1">
                    <mxGeometry x="1850" y="-294.1875000000001" width="340" height="98.38" as="geometry"/>
                </mxCell>
                <mxCell id="72" value="Vision &lt;br&gt;Subdimensions" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="2400" y="-635.5" width="120" height="60" as="geometry"/>
                </mxCell>
