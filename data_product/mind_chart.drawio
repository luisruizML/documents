                <mxCell id="16" value="&lt;div&gt;- Outdated systems&lt;/div&gt;&lt;div&gt;- Manual tasks&lt;/div&gt;&lt;div&gt;- Low visibility into their workload&lt;/div&gt;&lt;div&gt;- Large backlogs&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;horizontal=1;" vertex="1" parent="1">
