                <mxCell id="75" value="Trusted digital identity &amp;amp; access" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="2580" y="-245.565" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="76" value="Interoperable data &amp;amp; interface ecosystem" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="3370" y="-1130" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="77" value="Risk-based compliance management" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="3370" y="-1061" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="80" value="Resilience &amp;amp; inclusivity" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="3370" y="-855" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="81" value="Responsible innovation &amp;amp; assurance" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="3370" y="-786" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="82" value="Engineering quality &amp;amp; scalability" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="3370" y="-717" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="83" value="Service &amp;amp; commercial packaging" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="3370" y="-648" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="84" value="Product governance &amp;amp; team structure" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="3370" y="-580" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="78" value="Enforcement &amp;amp; compliance" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="3370" y="-992" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="79" value="Policy insight and capability development" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="3370" y="-923" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="87" value="&lt;h1&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Modular &amp;amp; Decoupled Design&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;Independent core modules are composed to create complete tax administration workflows. They communicate seamlessly through an API gateway, allowing each module to evolve independently.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="2750" y="-1331.5" width="500" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="90" value="&lt;h1&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Feature-Flag Approach&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;Each module uses feature flags, meaning specific capabilities can be toggled on or off depending on a jurisdiction's specific needs. This allows administrations to adopt only what they need and scale safely over time without replacing the whole system.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="2750" y="-1224" width="500" height="100.19" as="geometry"/>
                </mxCell>
                <mxCell id="91" value="&lt;h1&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;The Tax Studio&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;Taxes (like VAT, CIT, and PIT) are defined through configurable templates rather than hard-coded software. This turns taxation into a flexible &quot;policy capability&quot; controlled by the administration, rather than vendor-controlled software.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="2750" y="-1114" width="500" height="96.12" as="geometry"/>
                </mxCell>
                <mxCell id="92" value="&lt;h1&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Unified Data Layer&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;The architecture sits on a foundational Data Layer that maintains consistent rules across core components while smoothly interacting with different data sets.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="2750" y="-1003" width="500" height="88.5" as="geometry"/>
                </mxCell>
                <mxCell id="93" value="&lt;h1&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Highly Adaptable&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;Because capabilities can be activated at different percentages (e.g., 50% of Component A, 80% of Component C) and organized uniquely, the platform naturally molds to the specific processes of any given jurisdiction.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="2750" y="-900" width="500" height="97.5" as="geometry"/>
                </mxCell>
                <mxCell id="100" value="&lt;h1&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Configurable Workflows&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;Tax administrations are not locked into predefined processes. They can design custom task flows and notifications, which gives tax officers clear visibility and control over their daily tasks.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="2740" y="-786.49" width="500" height="100.19" as="geometry"/>
                </mxCell>
                <mxCell id="101" value="&lt;h1&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Embedded Compliance&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;For taxpayers, the MTS integrates tax compliance directly into the natural systems they already use—such as payroll, accounting, and banking platforms—cutting down on repetitive data entry and manual reporting.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="2740" y="-676.49" width="500" height="96.12" as="geometry"/>
                </mxCell>
                <mxCell id="102" value="&lt;h1&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Automation &amp;amp; Prefilled Returns&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;Where legislation permits, the platform automatically generates required documents and pre-fills tax returns using data pulled from other tax types and trusted third parties. It also assigns obligations automatically based on clear rules and thresholds.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="2740" y="-565.49" width="500" height="88.5" as="geometry"/>
                </mxCell>
                <mxCell id="103" value="&lt;h1&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Transparent Communication&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;The system ensures individuals and businesses clearly understand what is required of them, when it is due, and why through timely, transparent notifications.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="2740" y="-462.49" width="500" height="97.5" as="geometry"/>
                </mxCell>
                <mxCell id="108" value="&lt;h1&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Flexible Implementation&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;The system can be deployed as a basic registration module where needed, or scaled into a full digital identity layer connecting people and businesses across tax and other public services.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="2730" y="-365.87" width="500" height="96.12" as="geometry"/>
                </mxCell>
                <mxCell id="109" value="&lt;h1&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Centralized Gateway&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;By centralizing taxpayer information, citizens and businesses can interact through a single, reliable identity rather than juggling fragmented credentials across various government systems.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="2730" y="-263" width="500" height="94.87" as="geometry"/>
                </mxCell>
                <mxCell id="110" value="&lt;h1&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Interoperability over Replacement&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;Where a national digital identity or portal already exists, the MTS is designed to integrate with it rather than replace it. This respects existing investments while strengthening overall interoperability and reducing duplication.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=default;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="2730" y="-162.37" width="500" height="97.5" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>