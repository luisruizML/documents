                <mxCell id="34" value="High Administrative Burden" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontSize=9;fontColor=#FFFFFF;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1630" y="-921.8125000000001" width="180" height="30" as="geometry"/>
