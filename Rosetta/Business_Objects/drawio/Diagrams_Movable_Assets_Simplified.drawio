<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="SILVER: Movable Assets cluster (Data Vault 2.0)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Mulish;fontStyle=1;fontSize=16;fontColor=#3A0CA3;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="2129" height="30" as="geometry"/></mxCell><mxCell id="c3" value="hub_base_asset" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="647" y="632" width="250" height="200" as="geometry"/></mxCell><mxCell id="c4" value="The table that holds the identifier by which the registry of record knows each vessel, aircraft or other mobile asset, usually the number stamped on it, such as an IMO number, a vehicle identification number or a tail number. It carries no description of the asset." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c3"><mxGeometry x="0" y="30" width="250" height="90" as="geometry"/></mxCell><mxCell id="c5" value="lnk_base_asset__model_catalog" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1103" y="585" width="250" height="112" as="geometry"/></mxCell><mxCell id="c6" value="The table that records which model an asset is, so that the make and the specification are held once for every asset of that model. An asset has one model at a time, and a correction is a new row." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c5"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c7" value="lnk_base_asset__location" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1103" y="727" width="250" height="126" as="geometry"/></mxCell><mxCell id="c8" value="The table that records that a place belongs to an asset: its port of registry, its home port or the place where it is based. The role and the period are recorded in sat_base_asset__location__usage. It is the way a place is attached to an asset." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c7"><mxGeometry x="0" y="30" width="250" height="90" as="geometry"/></mxCell><mxCell id="c9" value="sat_base_asset__description" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="87" y="80" width="250" height="84" as="geometry"/></mxCell><mxCell id="c10" value="The table that records what an asset is, such as a vessel, an aircraft or a special vehicle, its class and the day it was built." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c9"><mxGeometry x="0" y="30" width="250" height="48" as="geometry"/></mxCell><mxCell id="c11" value="sat_base_asset__characteristic" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="87" y="194" width="250" height="112" as="geometry"/></mxCell><mxCell id="c12" value="The table that records the characteristics of an asset, such as its length, its tonnage or the number of seats and engines, one row for each characteristic, so the list can grow without changing the table." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c11"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c13" value="sat_base_asset__valuation" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="87" y="336" width="250" height="126" as="geometry"/></mxCell><mxCell id="c14" value="The table that records each valuation of an asset: the method, the value, the day it refers to and where it stands in the process of the jurisdiction, from draft to accepted or rejected. A change of status is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c13"><mxGeometry x="0" y="30" width="250" height="90" as="geometry"/></mxCell><mxCell id="c15" value="sat_base_asset__identification" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="87" y="492" width="250" height="112" as="geometry"/></mxCell><mxCell id="c16" value="The table that records the numbers and documents that identify an asset besides its key, such as a hull number, a call sign or a locally issued number for a canoe, who issued each and when, and when it stops being valid." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c15"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c17" value="sat_base_asset__registration" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="87" y="634" width="250" height="98" as="geometry"/></mxCell><mxCell id="c18" value="The table that records why and when an asset was registered (a builder's certificate, a bill of sale, an inspection or a declaration of the owner) and points to the evidence." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c17"><mxGeometry x="0" y="30" width="250" height="62" as="geometry"/></mxCell><mxCell id="c19" value="sat_base_asset__flag" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="87" y="762" width="250" height="112" as="geometry"/></mxCell><mxCell id="c20" value="The table that records the flag of an asset: the country whose nationality it carries and the kind of registry, from which day and until which day, and the evidence held for it. A change of flag is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c19"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c21" value="sat_base_asset__location__usage" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1691" y="784" width="251" height="126" as="geometry"/></mxCell><mxCell id="c22" value="The table that records how a place is used for an asset, such as its port of registry, its home port or its base, from which day and until which day, and the evidence held for it. An asset can have several places and a place can belong to several assets." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c21"><mxGeometry x="0" y="30" width="251" height="90" as="geometry"/></mxCell><mxCell id="c23" value="hub_swappable_component" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="647" y="862" width="250" height="200" as="geometry"/></mxCell><mxCell id="c24" value="The table that holds the identifier by which the registry or the maker knows each part that can be taken off one asset and fitted to another, such as an engine, usually its serial number. It carries no description of the part." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c23"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c25" value="lnk_base_asset__swappable_component" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1103" y="883" width="279" height="112" as="geometry"/></mxCell><mxCell id="c26" value="The table that records that a part is fitted to an asset. A part can be taken off one asset and fitted to another, and an asset has many parts; the period and the position are recorded in sat_base_asset__swappable_component__period." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c25"><mxGeometry x="0" y="30" width="279" height="76" as="geometry"/></mxCell><mxCell id="c27" value="lnk_model_catalog__swappable_component" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1103" y="1025" width="300" height="98" as="geometry"/></mxCell><mxCell id="c28" value="The table that records which model a part is, so that the make and the specification are held once for every part of that model. A part has one model at a time, and a correction is a new row." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c27"><mxGeometry x="0" y="30" width="300" height="62" as="geometry"/></mxCell><mxCell id="c29" value="lnk_swappable_component__swappable_component_hierarchy" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1103" y="1153" width="412" height="98" as="geometry"/></mxCell><mxCell id="c30" value="The table that records that one part lies inside another, such as a turbocharger inside an engine. It says which part contains which; the kind of containment and the period are recorded in sat_swappable_component__swappable_component_hierarchy__period." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c29"><mxGeometry x="0" y="30" width="412" height="62" as="geometry"/></mxCell><mxCell id="c31" value="sat_swappable_component__description" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="51" y="904" width="286" height="84" as="geometry"/></mxCell><mxCell id="c32" value="The table that records what a part is, such as an engine, a propeller, a gearbox or a rotor, and the day it was built." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c31"><mxGeometry x="0" y="30" width="286" height="48" as="geometry"/></mxCell><mxCell id="c33" value="sat_swappable_component__characteristic" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1018" width="307" height="98" as="geometry"/></mxCell><mxCell id="c34" value="The table that records the characteristics of a part, such as its power, its fuel type or its hours of use, one row for each characteristic, so the list can grow without changing the table." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c33"><mxGeometry x="0" y="30" width="307" height="62" as="geometry"/></mxCell><mxCell id="c35" value="sat_swappable_component__valuation" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="65" y="1146" width="272" height="112" as="geometry"/></mxCell><mxCell id="c36" value="The table that records each valuation of a part: the method, the value, the day it refers to and where it stands in the process of the jurisdiction, from draft to accepted or rejected. A change of status is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c35"><mxGeometry x="0" y="30" width="272" height="76" as="geometry"/></mxCell><mxCell id="c37" value="sat_swappable_component__identification" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1288" width="307" height="98" as="geometry"/></mxCell><mxCell id="c38" value="The table that records the numbers and documents that identify a part besides its key, such as a serial number, a type certificate number or a locally issued number, who issued each and when, and when it stops being valid." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c37"><mxGeometry x="0" y="30" width="307" height="62" as="geometry"/></mxCell><mxCell id="c39" value="sat_swappable_component__registration" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="44" y="1416" width="293" height="98" as="geometry"/></mxCell><mxCell id="c40" value="The table that records why and when a part was registered (a maker's certificate, a bill of sale, an inspection or a declaration of the owner) and points to the evidence." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c39"><mxGeometry x="0" y="30" width="293" height="62" as="geometry"/></mxCell><mxCell id="c41" value="sat_base_asset__swappable_component__period" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1691" y="940" width="335" height="84" as="geometry"/></mxCell><mxCell id="c42" value="The table that records the period in which a part is fitted to an asset, where on it, and why it left, such as removed or replaced. A change is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c41"><mxGeometry x="0" y="30" width="335" height="48" as="geometry"/></mxCell><mxCell id="c43" value="sat_swappable_component__swappable_component_hierarchy__period" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1691" y="1054" width="468" height="84" as="geometry"/></mxCell><mxCell id="c44" value="The table that records the kind of containment between a part and the part inside it, such as a sub-assembly or an accessory, the period in which it applies and why it ended. A change is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c43"><mxGeometry x="0" y="30" width="468" height="48" as="geometry"/></mxCell><mxCell id="c45" value="hub_model_catalog" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="647" y="1092" width="250" height="112" as="geometry"/></mxCell><mxCell id="c46" value="The table that holds the identifier of each make and model, such as a type of ship, an airframe or an engine, so that the specification is held once for every asset or part of that model. It carries no description of the model." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c45"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c47" value="sat_model_catalog__description" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="87" y="1544" width="250" height="84" as="geometry"/></mxCell><mxCell id="c48" value="The table that records what a model is: the kind of thing it describes, its maker and its name, as the maker writes them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c47"><mxGeometry x="0" y="30" width="250" height="48" as="geometry"/></mxCell><mxCell id="c49" value="sat_model_catalog__characteristic" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="72" y="1658" width="265" height="98" as="geometry"/></mxCell><mxCell id="c50" value="The table that records the specification of a model, such as its seats, its maximum weight or its rated power, one row for each characteristic, so the list can grow without changing the table." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c49"><mxGeometry x="0" y="30" width="265" height="62" as="geometry"/></mxCell><mxCell id="c51" value="hub_location" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1691" y="698" width="250" height="56" as="geometry"/></mxCell><mxCell id="c52" value="Defined on its own page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c51"><mxGeometry x="0" y="30" width="250" height="20" as="geometry"/></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.3333;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c5" target="c3"><mxGeometry x="-0.9247" relative="1" as="geometry"><Array as="points"><mxPoint x="1011" y="622.333"/><mxPoint x="1011" y="682"/></Array></mxGeometry></mxCell><mxCell id="c54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.6667;exitDx=0;exitDy=0;entryX=1;entryY=0.3333;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c5" target="c45"><mxGeometry x="-0.9704" relative="1" as="geometry"><Array as="points"><mxPoint x="1023" y="659.667"/><mxPoint x="1023" y="1129.33"/></Array></mxGeometry></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;e