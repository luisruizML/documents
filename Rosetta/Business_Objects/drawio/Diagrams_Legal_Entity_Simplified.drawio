<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="SILVER: Legal Entity cluster (Data Vault 2.0)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Mulish;fontStyle=1;fontSize=16;fontColor=#3A0CA3;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1836" height="30" as="geometry"/></mxCell><mxCell id="c3" value="hub_legal_entity" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="490" y="277" width="250" height="200" as="geometry"/></mxCell><mxCell id="c4" value="The table that holds the identifier by which the source of record knows each organization, association or collective recognized by the State: a registration or tax number for a formal entity, a registry code for an informal one. It carries no description of the entity." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c3"><mxGeometry x="0" y="30" width="250" height="90" as="geometry"/></mxCell><mxCell id="c5" value="lnk_legal_entity__party" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="898" y="80" width="250" height="112" as="geometry"/></mxCell><mxCell id="c6" value="The table that places every legal entity in the same universe as the natural persons, which together are the Parties. It says that a legal entity is a party; who owns it is recorded in lnk_legal_entity__party_owner." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c5"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c7" value="lnk_legal_entity__natural_person" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="898" y="222" width="258" height="112" as="geometry"/></mxCell><mxCell id="c8" value="The table that records that a natural person acts for a legal entity, such as a director, a representative or a tribal chief. The role and the dates are recorded in sat_legal_entity__natural_person__representation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c7"><mxGeometry x="0" y="30" width="258" height="76" as="geometry"/></mxCell><mxCell id="c9" value="lnk_legal_entity__party_owner" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="898" y="364" width="250" height="140" as="geometry"/></mxCell><mxCell id="c10" value="The table that records that a party owns a legal entity. The owner can be a natural person or another legal entity, and one entity can have many owners; the share and the state of each holding are recorded in sat_legal_entity__party_owner__ownership. It is not the identity table lnk_legal_entity__party." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c9"><mxGeometry x="0" y="30" width="250" height="104" as="geometry"/></mxCell><mxCell id="c11" value="lnk_legal_entity__legal_entity_hierarchy" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="898" y="534" width="314" height="140" as="geometry"/></mxCell><mxCell id="c12" value="The table that records that one legal entity is a member of another, such as a company that belongs to a holding group. It says who groups whom; the kind of grouping and the period are recorded in sat_legal_entity__legal_entity_hierarchy__membership. It is a grouping and not ownership, which is recorded in lnk_legal_entity__party_owner." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c11"><mxGeometry x="0" y="30" width="314" height="104" as="geometry"/></mxCell><mxCell id="c13" value="sat_legal_entity__name" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="38" y="108" width="250" height="98" as="geometry"/></mxCell><mxCell id="c14" value="The table that records the names a legal entity is known by, such as its legal name, a trading name or a community name, and the writing system of each." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c13"><mxGeometry x="0" y="30" width="250" height="62" as="geometry"/></mxCell><mxCell id="c15" value="sat_legal_entity__identification" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="236" width="258" height="112" as="geometry"/></mxCell><mxCell id="c16" value="The table that records the identifiers of a legal entity, such as a tax number, a company registration number or a community registry code, who issued each and, for an informal entity, the community it is tied to." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c15"><mxGeometry x="0" y="30" width="258" height="76" as="geometry"/></mxCell><mxCell id="c17" value="sat_legal_entity__classification" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="378" width="258" height="112" as="geometry"/></mxCell><mxCell id="c18" value="The table that records how a legal entity is classified, with one row for each criterion: whether it is corporate or collective, its legal form in the jurisdiction, and any other criterion a jurisdiction adds, such as its economic activity or its size." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c17"><mxGeometry x="0" y="30" width="258" height="76" as="geometry"/></mxCell><mxCell id="c19" value="sat_legal_entity__lifecycle" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="38" y="520" width="250" height="126" as="geometry"/></mxCell><mxCell id="c20" value="The table that records the events in the life of a legal entity, each with its date, its place and its evidence: incorporation, formal recognition, dissolution, bankruptcy, merger and restoration. Whether an entity is active is worked out from these events, not stored." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c19"><mxGeometry x="0" y="30" width="250" height="90" as="geometry"/></mxCell><mxCell id="c21" value="sat_legal_entity__natural_person__representation" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1468" y="288" width="370" height="84" as="geometry"/></mxCell><mxCell id="c22" value="The table that records how a natural person acts for a legal entity: the role, and when the person took it and left it. A person can hold several roles." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c21"><mxGeometry x="0" y="30" width="370" height="48" as="geometry"/></mxCell><mxCell id="c23" value="sat_legal_entity__legal_entity_hierarchy__membership" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1468" y="558" width="398" height="84" as="geometry"/></mxCell><mxCell id="c24" value="The table that records the kind of grouping between a parent and a member legal entity, such as a holding group or a branch, the period in which it applies and why it ended. A change is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c23"><mxGeometry x="0" y="30" width="398" height="48" as="geometry"/></mxCell><mxCell id="c25" value="sat_legal_entity__party_owner__ownership" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1468" y="402" width="314" height="126" as="geometry"/></mxCell><mxCell id="c26" value="The table that records each holding by which a party owns a legal entity: the legal nature of the title, the share, any restriction on distributions or disposal, and whether the award is fully vested, with the dates each applies. Each type of holding is its own entry, and a change is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c25"><mxGeometry x="0" y="30" width="314" height="90" as="geometry"/></mxCell><mxCell id="c27" value="hub_party" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1468" y="112" width="250" height="60" as="geometry"/></mxCell><mxCell id="c28" value="Defined on its own page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c27"><mxGeometry x="0" y="30" width="250" height="20" as="geometry"/></mxCell><mxCell id="c29" value="hub_natural_person" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1468" y="202" width="250" height="56" as="geometry"/></mxCell><mxCell id="c30" value="Defined on its own page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c29"><mxGeometry x="0" y="30" width="250" height="20" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.1667;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c5" target="c3"><mxGeometry x="-0.9398" relative="1" as="geometry"><Array as="points"><mxPoint x="818" y="136"/><mxPoint x="818" y="310.333"/></Array></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3333;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c5" target="c27"><mxGeometry x="-0.9383" relative="1" as="geometry"><Array as="points"><mxPoint x="1176" y="136"/><mxPoint x="1176" y="132"/></Array></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3333;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c7" target="c3"><mxGeometry x="-0.9106" relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="278"/><mxPoint x="830" y="343.667"/></Array></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.3333;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c7" target="c29"><mxGeometry x="-0.9414" relative="1" as="geometry"><Array as="points"><mxPoint x="1188" y="259.333"/><mxPoint x="1188" y="230"/></Array></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c9" target="c3"><mxGeometry x="-0.907" relative="1" as="geometry"><Array as="points"><mxPoint x="796" y="434"/><mxPoint x="796" y="377"/></Array></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.3333;exitDx=0;exitDy=0;entryX=0;entryY=0.6667;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c9" target="c27"><mxGeometry x="-0.9654" relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="410.667"/><mxPoint x="1200" y="152"/></Array></mxGeometry></mxCell><mxCell id="c37" value="parent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.3333;exitDx=0;exitDy=0;entryX=1;entryY=0.6667;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c11" target="c3"><mxGeometry x="-0.7929" relative="1" as="geometry"><Array as="points"><mxPoint x="784" y="580.667"/><mxPoint x="784" y="410.333"/></Array></mxGeometry></mxCell><mxCell id="c38" value="member" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.6667;exitDx=0;exitDy=0;entryX=1;entryY=0.8333;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c11" target="c3"><mxGeometry x="-0.801" relative="1" as="geometry"><Array as="points"><mxPoint x="772" y="627.333"/><mxPoint x="772" y="443.667"/></Array></mxGeometry></mxCell><mxCell id="c39" value="name" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c13" target="c3"><mxGeometry x="-0.8508" relative="1" as="geometry"><Array as="points"><mxPoint x="424" y="157"/><mxPoint x="424" y="317"/></Array></mxGeometry></mxCell><mxCell id="c40" value="identification" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c15" target="c3"><mxGeometry x="-0.5356" relative="1" as="geometry"><Array as="points"><mxPoint x="412" y="292"/><mxPoint x="412" y="357"/></Array></mxGeometry></mxCell><mxCell id="c41" value="classification" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c17" target="c3"><mxGeometry x="-0.4812" relative="1" as="geometry"><Array as="points"><mxPoint x="446" y="434"/><mxPoint x="446" y="397"/></Array></mxGeometry></mxCell><mxCell id="c42" value="lifecycle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c19" target="c3"><mxGeometry x="-0.7443" relative="1" as="geometry"><Array as="points"><mxPoint x="458" y="583"/><mxPoint x="458" y="437"/></Array></mxGeometry></mxCell><mxCell id="c43" value="representation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6667;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c21" target="c7"><mxGeometry x="-0.6409" relative="1" as="geometry"><Array as="points"><mxPoint x="1322" y="330"/><mxPoint x="1322" y="296.667"/></Array></mxGeometry></mxCell><mxCell id="c44" value="membership" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c23" target="c11"><mxGeometry x="-0.6308" relative="1" as="geometry"><Array as="points"><mxPoint x="1344" y="600"/><mxPoint x="1344" y="604"/></Array></mxGeometry></mxCell><mxCell id="c45" value="ownership" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6667;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c25" target="c9"><mxGeometry x="-0.7284" relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="465"/><mxPoint x="1310" y="457.333"/></Array></mxGeometry></mxCell><mxCell id="c46" value="" style="rounded=1;arcSize=20;fillColor=#3A0CA3;strokeColor=#A692D6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="714" width="22" height="22" as="geometry"/></mxCell><mxCell id="c47" value="Hub" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="58" y="714" width="110" height="22" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=1;arcSize=20;fillColor=#45E3CD;strokeColor=#29887B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="180" y="714" width="22" height="22" as="geometry"/></mxCell><mxCell id="c49" value="Link" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="208" y="714" width="110" height="22" as="geometry"/></mxCell><mxCell id="c50" value="" style="rounded=1;arcSize=20;fillColor=#F72586;strokeColor=#FB9DC9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="714" width="22" height="22" as="geometry"/></mxCell><mxCell id="c51" value="Satellite" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="358" y="714" width="110" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>