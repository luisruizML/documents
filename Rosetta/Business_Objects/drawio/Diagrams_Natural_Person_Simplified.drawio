<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="SILVER: Natural Person cluster (Data Vault 2.0)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Mulish;fontStyle=1;fontSize=16;fontColor=#3A0CA3;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="2109" height="30" as="geometry"/></mxCell><mxCell id="c3" value="hub_natural_person" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="786" y="586" width="250" height="280" as="geometry"/></mxCell><mxCell id="c4" value="The table that holds the identifier by which the source of record knows each individual person in the platform. It carries no description of the person; that is kept in the tables around it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c3"><mxGeometry x="0" y="30" width="250" height="62" as="geometry"/></mxCell><mxCell id="c5" value="lnk_natural_person__party" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1177" y="606" width="250" height="112" as="geometry"/></mxCell><mxCell id="c6" value="The table that places every natural person in the same universe as the legal entities, which together are the Parties. Any object that must point to &quot;whoever owes or asks&quot;, of either kind, goes through the Party." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c5"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c7" value="lnk_natural_person__natural_person_relation" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1177" y="748" width="335" height="98" as="geometry"/></mxCell><mxCell id="c8" value="The table that records that one person is related to another, such as spouses or a parent and a child. It says who is related; what the relationship is, and whether it still applies, is recorded in sat_natural_person__natural_person_relation__relationship." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c7"><mxGeometry x="0" y="30" width="335" height="62" as="geometry"/></mxCell><mxCell id="c9" value="sat_natural_person__name" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="157" y="80" width="250" height="98" as="geometry"/></mxCell><mxCell id="c10" value="The table that records the names a person is known by, such as a legal name, an alias or a tribal title, and the writing system of each. A person can have several." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c9"><mxGeometry x="0" y="30" width="250" height="62" as="geometry"/></mxCell><mxCell id="c11" value="sat_natural_person__identification" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="135" y="208" width="272" height="98" as="geometry"/></mxCell><mxCell id="c12" value="The table that records the documents and numbers that identify a person, such as a passport, a residence permit or a national identity number, and when each stops being valid." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c11"><mxGeometry x="0" y="30" width="272" height="62" as="geometry"/></mxCell><mxCell id="c13" value="sat_natural_person__registration" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="149" y="336" width="258" height="98" as="geometry"/></mxCell><mxCell id="c14" value="The table that records why and when a person was registered (a document, a biometric, a testimony or a census) and points to the evidence." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c13"><mxGeometry x="0" y="30" width="258" height="62" as="geometry"/></mxCell><mxCell id="c15" value="sat_natural_person__lifecycle" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="157" y="464" width="250" height="98" as="geometry"/></mxCell><mxCell id="c16" value="The table that records whether a person is active and the events that began and ended that status: birth or immigration, and confirmed death." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c15"><mxGeometry x="0" y="30" width="250" height="62" as="geometry"/></mxCell><mxCell id="c17" value="sat_natural_person__demographics" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;dashed=1;fillColor=#FCB3D5;swimlaneFillColor=#FFFFFF;strokeColor=#976B80;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="149" y="592" width="258" height="126" as="geometry"/></mxCell><mxCell id="c18" value="The table that holds only the current gender of a person, replaced when it changes. It is the exception, loaded only where a jurisdiction forbids keeping previous values; sat_natural_person__demographics_history is the default." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c17"><mxGeometry x="0" y="30" width="258" height="90" as="geometry"/></mxCell><mxCell id="c19" value="sat_natural_person__demographics_history" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="93" y="748" width="314" height="84" as="geometry"/></mxCell><mxCell id="c20" value="The table that records every gender recorded for a person over time, so earlier values stay. It is the default; sat_natural_person__demographics is the exception." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c19"><mxGeometry x="0" y="30" width="314" height="48" as="geometry"/></mxCell><mxCell id="c21" value="sat_natural_person__physical_traits" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;dashed=1;fillColor=#FCB3D5;swimlaneFillColor=#FFFFFF;strokeColor=#976B80;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="128" y="862" width="279" height="126" as="geometry"/></mxCell><mxCell id="c22" value="The table that holds only the current height and blood type of a person, replaced when they change. It is the exception, loaded only where a jurisdiction forbids keeping previous values; sat_natural_person__physical_traits_history is the default." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c21"><mxGeometry x="0" y="30" width="279" height="90" as="geometry"/></mxCell><mxCell id="c23" value="sat_natural_person__physical_traits_history" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="72" y="1018" width="335" height="84" as="geometry"/></mxCell><mxCell id="c24" value="The table that records every height and blood type recorded for a person over time, so earlier values stay. It is the default; sat_natural_person__physical_traits is the exception." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c23"><mxGeometry x="0" y="30" width="335" height="48" as="geometry"/></mxCell><mxCell id="c25" value="sat_natural_person__community_affiliation" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;dashed=1;fillColor=#FCB3D5;swimlaneFillColor=#FFFFFF;strokeColor=#976B80;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="86" y="1132" width="321" height="112" as="geometry"/></mxCell><mxCell id="c26" value="The table that holds only the current ethnicity, tribe and religion of a person, replaced when they change. It is the exception, loaded only where a jurisdiction forbids keeping previous values; sat_natural_person__community_affiliation_history is the default." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c25"><mxGeometry x="0" y="30" width="321" height="76" as="geometry"/></mxCell><mxCell id="c27" value="sat_natural_person__community_affiliation_history" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1274" width="377" height="98" as="geometry"/></mxCell><mxCell id="c28" value="The table that records every ethnicity, tribe and religion recorded for a person over time, so earlier values stay. It is the default. This is special-category data: it is collected only where the jurisdiction allows it and seen only by the roles that may." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c27"><mxGeometry x="0" y="30" width="377" height="62" as="geometry"/></mxCell><mxCell id="c29" value="sat_natural_person__natural_person_relation__relationship" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1706" y="727" width="433" height="84" as="geometry"/></mxCell><mxCell id="c30" value="The table that records the kind, the state and the end of each relationship between two people over time: a marriage and its divorce, or a parent's responsibility for a child until the child comes of age and beyond it for a disability." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c29"><mxGeometry x="0" y="30" width="433" height="48" as="geometry"/></mxCell><mxCell id="c31" value="hub_party" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1706" y="641" width="250" height="56" as="geometry"/></mxCell><mxCell id="c32" value="Defined on its own page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c31"><mxGeometry x="0" y="30" width="250" height="20" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c5" target="c3"><mxGeometry x="-0.8639" relative="1" as="geometry"><Array as="points"><mxPoint x="1102" y="662"/><mxPoint x="1102" y="656"/></Array></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c5" target="c31"><mxGeometry x="-0.9301" relative="1" as="geometry"><Array as="points"><mxPoint x="1447" y="662"/><mxPoint x="1447" y="669"/></Array></mxGeometry></mxCell><mxCell id="c35" value="subject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.3333;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c7" target="c3"><mxGeometry x="-0.6167" relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="780.667"/><mxPoint x="1090" y="726"/></Array></mxGeometry></mxCell><mxCell id="c36" value="related" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.6667;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c7" target="c3"><mxGeometry x="-0.5263" relative="1" as="geometry"><Array as="points"><mxPoint x="1078" y="813.333"/><mxPoint x="1078" y="796"/></Array></mxGeometry></mxCell><mxCell id="c37" value="name" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.0909;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c9" target="c3"><mxGeometry x="-0.9373" relative="1" as="geometry"><Array as="points"><mxPoint x="684" y="129"/><mxPoint x="684" y="611.455"/></Array></mxGeometry></mxCell><mxCell id="c38" value="identification" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1818;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c11" target="c3"><mxGeometry x="-0.8366" relative="1" as="geometry"><Array as="points"><mxPoint x="672" y="257"/><mxPoint x="672" y="636.909"/></Array></mxGeometry></mxCell><mxCell id="c39" value="registration" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2727;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c13" target="c3"><mxGeometry x="-0.8324" relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="385"/><mxPoint x="660" y="662.364"/></Array></mxGeometry></mxCell><mxCell id="c40" value="lifecycle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3636;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c15" target="c3"><mxGeometry x="-0.8393" relative="1"