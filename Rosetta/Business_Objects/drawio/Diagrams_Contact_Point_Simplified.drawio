<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="SILVER: Contact Point cluster (Data Vault 2.0)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Mulish;fontStyle=1;fontSize=16;fontColor=#3A0CA3;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1555" height="30" as="geometry"/></mxCell><mxCell id="c3" value="hub_contact_point" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="437" y="272" width="250" height="112" as="geometry"/></mxCell><mxCell id="c4" value="The table that holds the identifier by which the platform knows each way to reach a party that is not a place, such as a phone number, an email address or a messaging account. It carries no description of the contact point." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c3"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c5" value="lnk_contact_point__party" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="817" y="258" width="250" height="140" as="geometry"/></mxCell><mxCell id="c6" value="The table that records that a contact point belongs to a party, a natural person or a legal entity. The use, the consent and the confirmation of each channel are recorded in the Satellites of this table. A contact point can belong to several parties and a party can have several contact points." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c5"><mxGeometry x="0" y="30" width="250" height="104" as="geometry"/></mxCell><mxCell id="c7" value="sat_contact_point__description" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="187" width="250" height="140" as="geometry"/></mxCell><mxCell id="c8" value="The table that records the value of a contact point: what kind it is (a mobile number, a fixed line, an email address or a messaging handle), the number, address or handle in a normalized form with its extension and, for a handle, the messaging service it belongs to. It is personal data." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c7"><mxGeometry x="0" y="30" width="250" height="104" as="geometry"/></mxCell><mxCell id="c9" value="sat_contact_point__channel" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="357" width="250" height="112" as="geometry"/></mxCell><mxCell id="c10" value="The table that records which channels reach a contact point, such as voice, SMS, WhatsApp, iMessage or Telegram, from which day and until which day. A change is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c9"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c11" value="sat_contact_point__party__usage" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1285" y="166" width="251" height="126" as="geometry"/></mxCell><mxCell id="c12" value="The table that records how a party uses a contact point, such as personal, work or billing, whether it is the preferred one, from which day and until which day, and the evidence held for it. A party can use one contact point in several roles." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c11"><mxGeometry x="0" y="30" width="251" height="90" as="geometry"/></mxCell><mxCell id="c13" value="sat_contact_point__party__consent" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1285" y="322" width="265" height="126" as="geometry"/></mxCell><mxCell id="c14" value="The table that records whether a party agreed to be reached through a channel for a purpose, such as a service notice, a tax notice or marketing, on what basis, in which period and with what evidence. A withdrawal is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c13"><mxGeometry x="0" y="30" width="265" height="90" as="geometry"/></mxCell><mxCell id="c15" value="sat_contact_point__party__verification" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1285" y="478" width="300" height="98" as="geometry"/></mxCell><mxCell id="c16" value="The table that records whether a party confirmed that it is reached on a channel of a contact point, the day it was confirmed and the period in which the status applies. A new confirmation is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c15"><mxGeometry x="0" y="30" width="300" height="62" as="geometry"/></mxCell><mxCell id="c17" value="hub_party" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1285" y="80" width="250" height="56" as="geometry"/></mxCell><mxCell id="c18" value="Defined on its own page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c17"><mxGeometry x="0" y="30" width="250" height="20" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c5" target="c3"><mxGeometry x="-0.8462" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c5" target="c17"><mxGeometry x="-0.9495" relative="1" as="geometry"><Array as="points"><mxPoint x="1087" y="286"/><mxPoint x="1087" y="108"/></Array></mxGeometry></mxCell><mxCell id="c21" value="description" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3333;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c7" target="c3"><mxGeometry x="-0.508" relative="1" as="geometry"><Array as="points"><mxPoint x="383" y="257"/><mxPoint x="383" y="309.333"/></Array></mxGeometry></mxCell><mxCell id="c22" value="channel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6667;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c9" target="c3"><mxGeometry x="-0.6642" relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="413"/><mxPoint x="405" y="346.667"/></Array></mxGeometry></mxCell><mxCell id="c23" value="usage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c11" target="c5"><mxGeometry x="-0.7987" relative="1" as="geometry"><Array as="points"><mxPoint x="1175" y="229"/><mxPoint x="1175" y="314"/></Array></mxGeometry></mxCell><mxCell id="c24" value="consent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c13" target="c5"><mxGeometry x="-0.7126" relative="1" as="geometry"><Array as="points"><mxPoint x="1153" y="385"/><mxPoint x="1153" y="342"/></Array></mxGeometry></mxCell><mxCell id="c25" value="verification" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c15" target="c5"><mxGeometry x="-0.7067" relative="1" as="geometry"><Array as="points"><mxPoint x="1141" y="527"/><mxPoint x="1141" y="370"/></Array></mxGeometry></mxCell><mxCell id="c26" value="" style="rounded=1;arcSize=20;fillColor=#3A0CA3;strokeColor=#A692D6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="616" width="22" height="22" as="geometry"/></mxCell><mxCell id="c27" value="Hub" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="58" y="616" width="110" height="22" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=1;arcSize=20;fillColor=#45E3CD;strokeColor=#29887B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="180" y="616" width="22" height="22" as="geometry"/></mxCell><mxCell id="c29" value="Link" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="208" y="616" width="110" height="22" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;arcSize=20;fillColor=#F72586;strokeColor=#FB9DC9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="616" width="22" height="22" as="geometry"/></mxCell><mxCell id="c31" value="Satellite" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="358" y="616" width="110" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>