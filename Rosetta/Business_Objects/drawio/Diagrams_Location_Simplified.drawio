xitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c25" target="c9"><mxGeometry x="-0.7393" relative="1" as="geometry"><Array as="points"><mxPoint x="419" y="527"/><mxPoint x="419" y="592"/></Array></mxGeometry></mxCell><mxCell id="c46" value="period" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c27" target="c17"><mxGeometry x="-0.7614" relative="1" as="geometry"><Array as="points"><mxPoint x="1437" y="364"/><mxPoint x="1437" y="485"/></Array></mxGeometry></mxCell><mxCell id="c47" value="usage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6667;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c29" target="c19"><mxGeometry x="-0.8764" relative="1" as="geometry"><Array as="points"><mxPoint x="1449" y="499"/><mxPoint x="1449" y="666.667"/></Array></mxGeometry></mxCell><mxCell id="c48" value="" style="rounded=1;arcSize=20;fillColor=#3A0CA3;strokeColor=#A692D6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="758" width="22" height="22" as="geometry"/></mxCell><mxCell id="c49" value="Hub" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="58" y="758" width="110" height="22" as="geometry"/></mxCell><mxCell id="c50" value="" style="rounded=1;arcSize=20;fillColor=#45E3CD;strokeColor=#29887B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="180" y="758" width="22" height="22" as="geometry"/></mxCell><mxCell id="c51" value="Link" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="208" y="758" width="110" height="22" as="geometry"/></mxCell><mxCell id="c52" value="" style="rounded=1;arcSize=20;fillColor=#F72586;strokeColor=#FB9DC9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="758" width="22" height="22" as="geometry"/></mxCell><mxCell id="c53" value="Satellite" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="358" y="758" width="110" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>