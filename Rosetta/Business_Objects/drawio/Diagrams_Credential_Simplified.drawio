<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="SILVER: Credential cluster (Data Vault 2.0)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Mulish;fontStyle=1;fontSize=16;fontColor=#3A0CA3;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1480" height="30" as="geometry"/></mxCell><mxCell id="c3" value="hub_credential" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="449" y="215" width="250" height="112" as="geometry"/></mxCell><mxCell id="c4" value="The table that holds the identifier by which the issuer knows each credential, such as the number of a card or the serial of a digital certificate. It carries no description of the credential." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c3"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c5" value="lnk_credential__entitlement" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="829" y="194" width="250" height="154" as="geometry"/></mxCell><mxCell id="c6" value="The table that records that a credential proves an entitlement. One entitlement can have many credentials over time, as a lost card is replaced by a new one, and a credential can prove several entitlements, as a card that shows several categories. The days a credential stands for an entitlement are recorded in sat_credential__entitlement__period." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c5"><mxGeometry x="0" y="30" width="250" height="118" as="geometry"/></mxCell><mxCell id="c7" value="sat_credential__description" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="250" height="84" as="geometry"/></mxCell><mxCell id="c8" value="The table that records what a credential is: its type, whether it is a physical card or a digital document, and who issued it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c7"><mxGeometry x="0" y="30" width="250" height="48" as="geometry"/></mxCell><mxCell id="c9" value="sat_credential__issuance" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="194" width="250" height="112" as="geometry"/></mxCell><mxCell id="c10" value="The table that records the day a credential was issued, until when it is valid and the pointer to the document itself. A renewal of the same credential is a new entry, so the earlier ones stay. It is personal data." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c9"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c11" value="sat_credential__status" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="336" width="250" height="126" as="geometry"/></mxCell><mxCell id="c12" value="The table that records where a credential stands as an object: active, lost, destroyed, stolen, surrendered, replaced, withheld or revoked, with the reason and the day. It says nothing about whether the right behind it still holds; that is kept apart in the Entitlement object." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c11"><mxGeometry x="0" y="30" width="250" height="90" as="geometry"/></mxCell><mxCell id="c13" value="sat_credential__entitlement__period" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1231" y="265" width="279" height="98" as="geometry"/></mxCell><mxCell id="c14" value="The table that records the days in which a credential stands as proof of an entitlement, why it stopped, and the evidence held for it. A replacement is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c13"><mxGeometry x="0" y="30" width="279" height="62" as="geometry"/></mxCell><mxCell id="c15" value="hub_entitlement" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1231" y="179" width="250" height="56" as="geometry"/></mxCell><mxCell id="c16" value="Defined on its own page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c15"><mxGeometry x="0" y="30" width="250" height="20" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c5" target="c3"><mxGeometry x="-0.8462" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.3333;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c5" target="c15"><mxGeometry x="-0.8949" relative="1" as="geometry"><Array as="points"><mxPoint x="1099" y="245.333"/><mxPoint x="1099" y="207"/></Array></mxGeometry></mxCell><mxCell id="c19" value="description" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c7" target="c3"><mxGeometry x="-0.6448" relative="1" as="geometry"><Array as="points"><mxPoint x="395" y="122"/><mxPoint x="395" y="243"/></Array></mxGeometry></mxCell><mxCell id="c20" value="issuance" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c9" target="c3"><mxGeometry x="-0.5684" relative="1" as="geometry"><Array as="points"><mxPoint x="383" y="250"/><mxPoint x="383" y="271"/></Array></mxGeometry></mxCell><mxCell id="c21" value="status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c11" target="c3"><mxGeometry x="-0.7472" relative="1" as="geometry"><Array as="points"><mxPoint x="417" y="399"/><mxPoint x="417" y="299"/></Array></mxGeometry></mxCell><mxCell id="c22" value="period" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;strokeColor=#A6A8AB;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6667;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Courier New;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c13" target="c5"><mxGeometry x="-0.5984" relative="1" as="geometry"><Array as="points"><mxPoint x="1163" y="314"/><mxPoint x="1163" y="296.667"/></Array></mxGeometry></mxCell><mxCell id="c23" value="" style="rounded=1;arcSize=20;fillColor=#3A0CA3;strokeColor=#A692D6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="502" width="22" height="22" as="geometry"/></mxCell><mxCell id="c24" value="Hub" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="58" y="502" width="110" height="22" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=1;arcSize=20;fillColor=#45E3CD;strokeColor=#29887B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="180" y="502" width="22" height="22" as="geometry"/></mxCell><mxCell id="c26" value="Link" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="208" y="502" width="110" height="22" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=1;arcSize=20;fillColor=#F72586;strokeColor=#FB9DC9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="502" width="22" height="22" as="geometry"/></mxCell><mxCell id="c28" value="Satellite" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="358" y="502" width="110" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>