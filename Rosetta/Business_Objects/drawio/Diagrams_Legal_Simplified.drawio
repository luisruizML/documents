<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="SILVER: Legal cluster (Data Vault 2.0)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Mulish;fontStyle=1;fontSize=16;fontColor=#3A0CA3;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="2022" height="30" as="geometry"/></mxCell><mxCell id="c3" value="hub_entitlement" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="552" y="700" width="250" height="200" as="geometry"/></mxCell><mxCell id="c4" value="The table that holds the identifier by which the issuing authority knows each entitlement, such as a driving licence, a fishing quota or a permit to change the use of a building. It carries no description of the entitlement." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c3"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c5" value="lnk_entitlement__party_holder" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1063" y="121" width="250" height="112" as="geometry"/></mxCell><mxCell id="c6" value="The table that records that a party holds an entitlement. The holder can be a natural person or a legal entity; the days it holds it and why it stopped are recorded in sat_entitlement__party_holder__period." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c5"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c7" value="lnk_base_asset__entitlement" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1063" y="263" width="250" height="140" as="geometry"/></mxCell><mxCell id="c8" value="The table that records that an entitlement applies to an asset, such as a fishing licence for a vessel or a tourism permit for a boat. The days it applies are recorded in sat_base_asset__entitlement__period. An entitlement can apply to several things and a thing can need several entitlements." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c7"><mxGeometry x="0" y="30" width="250" height="104" as="geometry"/></mxCell><mxCell id="c9" value="lnk_base_parcel__entitlement" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1063" y="433" width="250" height="140" as="geometry"/></mxCell><mxCell id="c10" value="The table that records that an entitlement applies to a parcel, such as a permit to build on a parcel or to farm it. The days it applies are recorded in sat_base_parcel__entitlement__period. An entitlement can apply to several things and a thing can need several entitlements." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c9"><mxGeometry x="0" y="30" width="250" height="104" as="geometry"/></mxCell><mxCell id="c11" value="lnk_built_structure__entitlement" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1063" y="603" width="258" height="140" as="geometry"/></mxCell><mxCell id="c12" value="The table that records that an entitlement applies to a structure, such as a permit to use a building as housing or an occupancy certificate. The days it applies are recorded in sat_built_structure__entitlement__period. An entitlement can apply to several things and a thing can need several entitlements." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c11"><mxGeometry x="0" y="30" width="258" height="104" as="geometry"/></mxCell><mxCell id="c13" value="sat_entitlement__description" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="268" width="250" height="84" as="geometry"/></mxCell><mxCell id="c14" value="The table that records what an entitlement allows: its type, the activity it covers and the authority that grants it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c13"><mxGeometry x="0" y="30" width="250" height="48" as="geometry"/></mxCell><mxCell id="c15" value="sat_entitlement__quota" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="382" width="250" height="112" as="geometry"/></mxCell><mxCell id="c16" value="The table that records a limit placed on an entitlement, such as tonnes of fish a year, days at sea or passengers carried, with the period it counts over. A change of limit is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c15"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c17" value="sat_entitlement__validity" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="524" width="250" height="98" as="geometry"/></mxCell><mxCell id="c18" value="The table that records the day an entitlement was granted and the period in which it can be used. A renewal is a new entry, so the earlier periods stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c17"><mxGeometry x="0" y="30" width="250" height="62" as="geometry"/></mxCell><mxCell id="c19" value="sat_entitlement__status" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="652" width="250" height="126" as="geometry"/></mxCell><mxCell id="c20" value="The table that records where an entitlement stands (active, suspended, revoked or surrendered), with the reason, the day and the decision behind it. It says nothing about the card or document that proves the entitlement; that is kept apart in the Credential object." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c19"><mxGeometry x="0" y="30" width="250" height="90" as="geometry"/></mxCell><mxCell id="c21" value="sat_entitlement__party_holder__period" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="526" width="293" height="98" as="geometry"/></mxCell><mxCell id="c22" value="The table that records the days in which a party holds an entitlement, why the holding ended and the evidence of a transfer. A change is a new entry, so the earlier ones stay. It is personal data." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c21"><mxGeometry x="0" y="30" width="293" height="62" as="geometry"/></mxCell><mxCell id="c23" value="sat_base_asset__entitlement__period" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="654" width="279" height="98" as="geometry"/></mxCell><mxCell id="c24" value="The table that records the days in which an entitlement applies to an asset, why it stopped, and the evidence held for it. A licence moved to a replacement is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c23"><mxGeometry x="0" y="30" width="279" height="62" as="geometry"/></mxCell><mxCell id="c25" value="sat_base_parcel__entitlement__period" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="782" width="286" height="98" as="geometry"/></mxCell><mxCell id="c26" value="The table that records the days in which an entitlement applies to a parcel, why it stopped, and the evidence held for it. A licence moved to a replacement is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c25"><mxGeometry x="0" y="30" width="286" height="62" as="geometry"/></mxCell><mxCell id="c27" value="sat_built_structure__entitlement__period" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="910" width="314" height="98" as="geometry"/></mxCell><mxCell id="c28" value="The table that records the days in which an entitlement applies to a structure, why it stopped, and the evidence held for it. A licence moved to a replacement is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c27"><mxGeometry x="0" y="30" width="314" height="62" as="geometry"/></mxCell><mxCell id="c29" value="hub_credential" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="552" y="930" width="250" height="112" as="geometry"/></mxCell><mxCell id="c30" value="The table that holds the identifier by which the issuer knows each credential, such as the number of a card or the serial of a digital certificate. It carries no description of the credential." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c29"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c31" value="lnk_credential__entitlement" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1063" y="773" width="250" height="154" as="geometry"/></mxCell><mxCell id="c32" value="The table that records that a credential proves an entitlement. One entitlement can have many credentials over time, as a lost card is replaced by a new one, and a credential can prove several entitlements, as a card that shows several categories. The days a credential stands for an entitlement are recorded in sat_credential__entitlement__period." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c31"><mxGeometry x="0" y="30" width="250" height="118" as="geometry"/></mxCell><mxCell id="c33" value="sat_credential__description" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="808" width="250" height="84" as="geometry"/></mxCell><mxCell id="c34" value="The table that records what a credential is: its type, whether it is a physical card or a digital document, and who issued it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c33"><mxGeometry x="0" y="30" width="250" height="48" as="geometry"/></mxCell><mxCell id="c35" value="sat_credential__issuance" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="922" width="250" height="112" as="geometry"/></mxCell><mxCell id="c36" value="The table that records the day a credential was issued, until when it is valid and the pointer to the document itself. A renewal of the same credential is a new entry, so the earlier ones stay. It is personal data." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c35"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c37" value="sat_credential__status" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1064" width="250" height="126" as="geometry"/></mxCell><mxCell id="c38" value="The table that records where a credential stands as an object: active, lost, destroyed, stolen, surrendered, replaced, withheld or revoked, with the reason and the day. It says nothing about whether the right behind it still holds; that is kept apart in the Entitlement object." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c37"><mxGeometry x="0" y="30" width="250" height="90" as="geometry"/></mxCell><mxCell id="c39" value="sat_credential__entitlement__period" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="1038" width="279" height="98" as="geometry"/></mxCell><mxCell id="c40" value="The table that records the days in which a credential stands as proof of an entitlement, why it stopped, and the evidence held for it. A replacement is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c39"><mxGeometry x="0" y="30" width="279" height="62" as="geometry"/></mxCell><mxCell id="c41" value="hub_rrr" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="552" y="1072" width="250" height="240" as="geometry"/></mxCell><mxCell id="c42" value="The table that holds the identifier by which the registry or the deed system knows each right, restriction or responsibility over a thing, such as an ownership, a lease, a mortgage or an embargo. It carries no description of it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c41"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c43" value="lnk_party__rrr" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1063" y="957" width="250" height="154" as="geometry"/></mxCell><mxCell id="c44" value="The table that records that a party takes part in a right, restriction or responsibility: as its holder, as the other side (a lessor or a lender) or as the authority that imposes it. The role, the share and the days are recorded in sat_party__rrr__participation. It is the way ownership, and every other bond between a party and a thing, is held." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c43"><mxGeometry x="0" y="30" width="250" height="118" as="geometry"/></mxCell><mxCell id="c45" value="lnk_base_asset__rrr" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1063" y="1141" width="250" height="126" as="geometry"/></mxCell><mxCell id="c46" value="The table that records that a right, restriction or responsibility binds an asset. One bond can cover several things, as a mortgage over three parcels, and a thing can have many bonds at once. The days it binds are recorded in sat_base_asset__rrr__period." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c45"><mxGeometry x="0" y="30" width="250" height="90" as="geometry"/></mxCell><mxCell id="c47" value="lnk_base_parcel__rrr" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1063" y="1297" width="250" height="126" as="geometry"/></mxCell><mxCell id="c48" value="The table that records that a right, restriction or responsibility binds a parcel. One bond can cover several things, as a mortgage over three parcels, and a thing can have many bonds at once. The days it binds are recorded in sat_base_parcel__rrr__period." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c47"><mxGeometry x="0" y="30" width="250" height="90" as="geometry"/></mxCell><mxCell id="c49" value="lnk_built_structure__rrr" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1063" y="1453" width="250" height="126" as="geometry"/></mxCell><mxCell id="c50" value="The table that records that a right, restriction or responsibility binds a structure. One bond can cover several things, as a mortgage over three parcels, and a thing can have many bonds at once. The days it binds are recorded in sat_built_structure__rrr__period." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c49"><mxGeometry x="0" y="30" width="250" height="90" as="geometry"/></mxCell><mxCell id="c51" value="lnk_rrr__swappable_component" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1063" y="1609" width="250" height="126" as="geometry"/></mxCell><mxCell id="c52" value="The table that records that a right, restriction or responsibility binds a part. One bond can cover several things, as a mortgage over three parcels, and a thing can have many bonds at once. The days it binds are recorded in sat_rrr__swappable_component__period." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c51"><mxGeometry x="0" y="30" width="250" height="90" as="geometry"/></mxCell><mxCell id="c53" value="lnk_rrr__rrr_hierarchy" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#45E3CD;swimlaneFillColor=#FFFFFF;strokeColor=#45E3CD;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1063" y="1765" width="250" height="126" as="geometry"/></mxCell><mxCell id="c54" value="The table that records that one right is derived from another, such as a lease from an ownership or a sublease from a lease. It says which is the source and which is derived; the kind of derivation and the period are recorded in sat_rrr__rrr_hierarchy__derivation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c53"><mxGeometry x="0" y="30" width="250" height="90" as="geometry"/></mxCell><mxCell id="c55" value="sat_rrr__description" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1220" width="250" height="112" as="geometry"/></mxCell><mxCell id="c56" value="The table that records what kind of bond a right, restriction or responsibility is: which of the three it is, its type (such as ownership, lease, mortgage, easement or embargo) and who imposed or granted it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c55"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c57" value="sat_rrr__validity" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1362" width="250" height="112" as="geometry"/></mxCell><mxCell id="c58" value="The table that records the period for which a right, restriction or responsibility runs, such as the term of a lease or the length of an embargo. An extension is a new entry, so the earlier periods stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c57"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c59" value="sat_rrr__status" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1504" width="250" height="112" as="geometry"/></mxCell><mxCell id="c60" value="The table that records where a right, restriction or responsibility stands (proposed, registered, disputed, discharged or cancelled), with the day and the decision behind it. A change of status is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c59"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c61" value="sat_rrr__registration" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1646" width="250" height="98" as="geometry"/></mxCell><mxCell id="c62" value="The table that records why and when a right, restriction or responsibility was registered (a title deed, a lease agreement, a court order or a testimony) and points to the evidence." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c61"><mxGeometry x="0" y="30" width="250" height="62" as="geometry"/></mxCell><mxCell id="c63" value="sat_party__rrr__participation" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="1166" width="250" height="112" as="geometry"/></mxCell><mxCell id="c64" value="The table that records how a party takes part in a right, restriction or responsibility: its role, its share where the bond is divided, and the days it applies. A change of holder is a new entry, so the earlier ones stay. It is personal data." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c63"><mxGeometry x="0" y="30" width="250" height="76" as="geometry"/></mxCell><mxCell id="c65" value="sat_base_asset__rrr__period" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="1308" width="250" height="98" as="geometry"/></mxCell><mxCell id="c66" value="The table that records the days in which a right, restriction or responsibility binds an asset, why it stopped, and the evidence held for it. A change is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c65"><mxGeometry x="0" y="30" width="250" height="62" as="geometry"/></mxCell><mxCell id="c67" value="sat_base_parcel__rrr__period" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="1436" width="250" height="98" as="geometry"/></mxCell><mxCell id="c68" value="The table that records the days in which a right, restriction or responsibility binds a parcel, why it stopped, and the evidence held for it. A change is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c67"><mxGeometry x="0" y="30" width="250" height="62" as="geometry"/></mxCell><mxCell id="c69" value="sat_built_structure__rrr__period" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="1564" width="258" height="98" as="geometry"/></mxCell><mxCell id="c70" value="The table that records the days in which a right, restriction or responsibility binds a structure, why it stopped, and the evidence held for it. A change is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c69"><mxGeometry x="0" y="30" width="258" height="62" as="geometry"/></mxCell><mxCell id="c71" value="sat_rrr__swappable_component__period" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="1692" width="286" height="98" as="geometry"/></mxCell><mxCell id="c72" value="The table that records the days in which a right, restriction or responsibility binds a part, why it stopped, and the evidence held for it. A change is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c71"><mxGeometry x="0" y="30" width="286" height="62" as="geometry"/></mxCell><mxCell id="c73" value="sat_rrr__rrr_hierarchy__derivation" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="1820" width="272" height="112" as="geometry"/></mxCell><mxCell id="c74" value="The table that records the kind of derivation between a right and the right it comes from, such as a lease or a sublease, the period in which it applies and why it ended. A change is a new entry, so the earlier ones stay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c73"><mxGeometry x="0" y="30" width="272" height="76" as="geometry"/></mxCell><mxCell id="c75" value="hub_party" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="80" width="250" height="60" as="geometry"/></mxCell><mxCell id="c76" value="Defined on its own page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c75"><mxGeometry x="0" y="30" width="250" height="20" as="geometry"/></mxCell><mxCell id="c77" value="hub_base_asset" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="170" width="250" height="60" as="geometry"/></mxCell><mxCell id="c78" value="Defined on its own page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c77"><mxGeometry x="0" y="30" width="250" height="20" as="geometry"/></mxCell><mxCell id="c79" value="hub_base_parcel" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="260" width="250" height="60" as="geometry"/></mxCell><mxCell id="c80" value="Defined on its own page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c79"><mxGeometry x="0" y="30" width="250" height="20" as="geometry"/></mxCell><mxCell id="c81" value="hub_built_structure" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1738" y="350" width="250" height="60" as="geometry"/></mxCell><mxCell id="c82" value="Defined on its own page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" 