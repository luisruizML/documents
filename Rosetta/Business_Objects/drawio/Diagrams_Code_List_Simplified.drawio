metry x="330" y="744" width="22" height="22" as="geometry"/></mxCell><mxCell id="c31" value="Satellite" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="358" y="744" width="110" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>