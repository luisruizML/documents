Geometry x="0" y="30" width="250" height="20" as="geometry"/></mxCell><mxCell id="c35" value="sat_base_parcel__entitlement__period" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#F72586;swimlaneFillColor=#FFFFFF;strokeColor=#F72586;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1491" y="866" width="286" height="56" as="geometry"/></mxCell><mxCell id="c36" value="Defined on its own page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c35"><mxGeometry x="0" y="30" width="286" height="20" as="geometry"/></mxCell><mxCell id="c37" value="hub_location" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1491" y="80" width="250" height="56" as="geometry"/></mxCell><mxCell id="c38" value="Defined on its own page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;spacingLeft=8;spacingRight=8;" vertex="1" parent="c37"><mxGeometry x="0" y="30" width="250" height="20" as="geometry"/></mxCell><mxCell id="c39" value="hub_built_structure" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=28;collapsible=1;fillColor=#3A0CA3;swimlaneFillColor=#FFFFFF;strokeColor=#3A0CA3;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1491" y="166" width="250" height="56" as="geometry"/></mxCell><mxCell id="c40" value="Defined on its own page" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFami